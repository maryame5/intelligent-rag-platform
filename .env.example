# --- Backend ---
ENVIRONMENT=development
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- PostgreSQL ---
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_password
POSTGRES_DB=rag_platform
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://rag_user:rag_password@postgres:5432/rag_platform

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- MinIO ---
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_password
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=documents

# --- Rate limiting ---
RATE_LIMIT_STORAGE_URI=redis://redis:6379/1

# --- CORS ---
# Origine(s) autorisée(s), séparées par des virgules. Ne JAMAIS remettre "*"
# en production — incompatible avec allow_credentials=True de toute façon.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- LLM / Embeddings (OpenRouter — plan gratuit) ---
LLM_API_KEY=sk-or-your-openrouter-key
LLM_MODEL=z-ai/glm-5.2:free
LLM_API_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=liquid/lfm-2.5-embedding-350m:free
EMBEDDING_API_BASE_URL=https://openrouter.ai/api/v1
# Modèles gratuits OpenRouter : rate-limités et non garantis pour de la donnée
# confidentielle en production (voir conditions du fournisseur). Suffisant pour
# le développement et la démo de portfolio.

# --- Email / SMTP (Exemple avec Brevo / Sendinblue — 300 emails/jour gratuits) ---
# Laissez vide en local pour consigner les emails et liens magiques dans les logs.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=votre-adresse@email.com
SMTP_PASSWORD=votre-cle-smtp-generee
SMTP_TLS=True
SMTP_SSL=False
EMAIL_FROM=no-reply@votredomaine.com
FRONTEND_URL=http://localhost:5173
# --- Langfuse (LLM Observability & Tracing) ---
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=http://localhost:3000

# --- Flower (Celery Monitoring) ---
FLOWER_BASIC_AUTH=admin:admin

