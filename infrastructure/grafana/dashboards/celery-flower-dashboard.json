          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "rate(ingestion_duration_seconds_sum[5m]) / rate(ingestion_duration_seconds_count[5m])",
          "legendFormat": "Durée moy. Ingestion RAG (s)",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Durée d'Exécution des Tâches (Celery / Ingestion)",
