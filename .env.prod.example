ENVIRONMENT=production
SECRET_KEY=replace-with-openssl-rand-hex-32

POSTGRES_USER=rag_user
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=rag_platform

MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=replace-with-a-strong-password

APP_DOMAIN=rag.example.com
API_DOMAIN=api.rag.example.com

# --- LLM (Groq recommandé : rapide, gratuit, compatible OpenAI) ---
# Clé gratuite sur https://console.groq.com/keys
LLM_API_KEY=replace-with-your-llm-api-key
LLM_MODEL=qwen/qwen3.8-27b
LLM_API_BASE_URL=https://api.groq.com/openai/v1
# Plafond de dépense LLM mensuel en USD (0 = désactivé).
# Recommandé si vous utilisez un modèle payant : évite les surprises de facturation.
# Ex : LLM_MONTHLY_SPEND_CAP_USD=10.0 pour bloquer à 10$/mois.
LLM_MONTHLY_SPEND_CAP_USD=0.0

# --- Embeddings (FastEmbed local — recommandé en production) ---
# Aucune clé API requise, aucun rate limit, vecteurs générés localement.
# IMPORTANT : ne jamais changer LOCAL_EMBEDDING_MODEL après indexation
# sans réindexer tous les documents (dimensions différentes).
EMBEDDING_PROVIDER_TYPE=local
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Monitoring (optionnel, profil "monitoring") ---
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-password